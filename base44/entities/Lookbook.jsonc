{
  "name": "Lookbook",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the lookbook collection"
    },
    "description": {
      "type": "string",
      "description": "Description of this lookbook"
    },
    "outfit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of outfit IDs in this lookbook"
    },
    "cover_image": {
      "type": "string",
      "description": "Cover image URL for the lookbook"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for organizing lookbooks"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}